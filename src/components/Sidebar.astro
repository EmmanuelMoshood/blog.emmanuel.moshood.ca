---
import { AVATAR, SITE_TAGLINE, SITE_TITLE, SOCIAL } from '../consts';

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Articles' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
const initials = SITE_TITLE.split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2);

const icons = {
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  github:
    'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3',
  rss: 'M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z',
} as const;
const social = (Object.keys(icons) as (keyof typeof icons)[])
  .filter((k) => SOCIAL[k])
  .map((k) => ({ key: k, href: SOCIAL[k], path: icons[k] }));
---

<aside class="sidebar">
  <a class="sidebar__brand" href="/">
    {
      AVATAR ? (
        <img class="sidebar__avatar" src={AVATAR} alt="" width="96" height="96" />
      ) : (
        <span class="sidebar__avatar sidebar__avatar--initials" aria-hidden="true">
          {initials}
        </span>
      )
    }
    <span class="sidebar__name">{SITE_TITLE}</span>
    <span class="sidebar__tagline">{SITE_TAGLINE}</span>
  </a>

  <nav class="sidebar__nav" aria-label="Main">
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul class="sidebar__social">
    {
      social.map(({ key, href, path }) => (
        <li>
          <a href={href} aria-label={key === 'rss' ? 'RSS feed' : key === 'github' ? 'GitHub' : 'LinkedIn'}>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d={path} fill="currentColor" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
